{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "guitar-app/lesson-v1", "title": "Guitar Lesson", "type": "object", "required": ["schema_version", "id", "title", "metadata", "musical_context", "sections", "practice_steps", "tips", "related_topics"], "properties": {"schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "title": {"type": "string", "minLength": 1}, "metadata": {"type": "object", "required": ["audience_level", "objectives", "prerequisites", "estimated_minutes"], "properties": {"audience_level": {"enum": ["beginner", "early-intermediate", "intermediate", "advanced"]}, "objectives": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "prerequisites": {"type": "array", "items": {"type": "string"}}, "estimated_minutes": {"type": "integer", "minimum": 5, "maximum": 120}, "prompt": {"type": "string", "description": "The original user prompt that generated this lesson"}}}, "musical_context": {"type": "object", "required": ["tuning", "key", "position_convention", "diagrams"], "properties": {"tuning": {"const": "standard"}, "key": {"type": "string", "pattern": "^[A-G][b#]?\\s(minor|major)$"}, "position_convention": {"enum": ["5-position", "caged", "3-note-per-string"]}, "diagrams": {"type": "array", "items": {"$ref": "#/$defs/diagram"}}}}, "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}, "minItems": 1}, "practice_steps": {"type": "array", "items": {"$ref": "#/$defs/practice_step"}, "minItems": 1}, "tips": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "related_topics": {"type": "array", "items": {"$ref": "#/$defs/topic_ref"}, "minItems": 1}}, "$defs": {"diagram": {"type": "object", "required": ["id", "type", "name", "render"], "properties": {"id": {"type": "string", "pattern": "^diagram-[a-z0-9-]+$"}, "type": {"enum": ["scale-diagram", "chord-diagram", "note-diagram"]}, "name": {"type": "string"}, "render": {"type": "object", "required": ["format", "strings", "frets", "notes"], "properties": {"format": {"const": "svg"}, "strings": {"type": "integer", "minimum": 6, "maximum": 6}, "frets": {"type": "object", "required": ["low", "high"], "properties": {"low": {"type": "integer", "minimum": 0}, "high": {"type": "integer", "minimum": 0}}}, "notes": {"type": "array", "items": {"type": "object", "required": ["string", "fret", "pitch_class", "is_root"], "properties": {"string": {"type": "integer", "minimum": 1, "maximum": 6}, "fret": {"type": "integer", "minimum": 0}, "pitch_class": {"enum": ["A", "A#/Bb", "B", "C", "C#/Db", "D", "D#/Eb", "E", "F", "F#/Gb", "G", "G#/Ab"]}, "is_root": {"type": "boolean"}}}}}}}}, "section": {"type": "object", "required": ["title", "body", "diagram_refs"], "properties": {"title": {"type": "string"}, "body": {"type": "string", "minLength": 50}, "diagram_refs": {"type": "array", "items": {"type": "string", "pattern": "^diagram-[a-z0-9-]+$"}}}}, "practice_step": {"type": "object", "required": ["goal", "action", "diagram_refs", "duration_minutes", "success_criterion"], "properties": {"goal": {"type": "string"}, "action": {"type": "string", "minLength": 20}, "diagram_refs": {"type": "array", "items": {"type": "string", "pattern": "^diagram-[a-z0-9-]+$"}}, "duration_minutes": {"type": "integer", "minimum": 1}, "bpm": {"type": "integer", "minimum": 30}, "reps": {"type": "integer", "minimum": 1}, "success_criterion": {"type": "string", "minLength": 10}}}, "topic_ref": {"type": "object", "required": ["id", "title"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "Must exist in the lesson catalog / knowledge graph"}, "title": {"type": "string"}, "reason": {"type": "string", "description": "Why this is a relevant next topic"}}}}}
