# Guitar Theory Chat — example environment.
# Copy to .env (git-ignored) and fill in. Every variable the app reads lives here.

# ── HTTP ────────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080

# ── Postgres ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://app:app@localhost:5432/theory?sslmode=disable

# ── LLM / embeddings (OpenAI-compatible REST) ────────────────────────────────
# Demo chat provider is OpenRouter. Embeddings may use a different base URL.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Leave empty to reuse LLM_BASE_URL for embeddings.
LLM_EMBED_BASE_URL=
LLM_API_KEY=
# OpenRouter slug for a small instruct model, e.g. meta-llama/llama-3.1-8b-instruct
LLM_CHAT_MODEL=
LLM_EMBED_MODEL=text-embedding-3-small
# Embedding model output width. MUST equal vector(N) in the applied migration;
# api and ingest refuse to start on a mismatch. 1536 matches text-embedding-3-small.
EMBEDDING_DIMENSIONS=1536

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
# Minimum cosine similarity. Chunks below this are dropped; none left => the
# canned "I don't have enough context" answer.
RETRIEVAL_MIN_SCORE=0.5

# ── History / follow-up query rewriting ──────────────────────────────────────
HISTORY_MESSAGE_LIMIT=10
REWRITE_HISTORY_MESSAGES=4
REWRITE_MAX_TOKENS=64

# ── Evaluation ───────────────────────────────────────────────────────────────
# Defaults to LLM_CHAT_MODEL when empty.
JUDGE_MODEL=
# Fraction of generated answers judged online (0..1). The canned answer is never judged.
ONLINE_EVAL_SAMPLE_RATE=1.0

# ── Datadog Agent Observability (US1, agentless) ─────────────────────────────
# Optional: when absent the app degrades to logs and never crashes on telemetry.
DD_API_KEY=
DD_SITE=datadoghq.com
DD_LLMOBS_ML_APP=guitar-chat
DD_LLMOBS_AGENTLESS_ENABLED=true
